# Copy to .env and fill in real values. Never commit the .env file.

# Generate e.g. with:
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
# Optional: storage directory for attachments (default: ./media)
DJANGO_MEDIA_ROOT=

POSTGRES_DB=agile_board
POSTGRES_USER=agile_board
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Public base URL used in e-mail links (production: must start with https://)
SITE_URL=http://localhost:8000

# E-mail (development defaults to the console backend)
EMAIL_BACKEND=
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=Agile Board <agile-board@localhost>
# Validity of password reset links in seconds
PASSWORD_RESET_TIMEOUT=7200

# Login protection
LOGIN_FAILURE_LIMIT=5
LOGIN_IP_FAILURE_LIMIT=20
LOGIN_LOCKOUT_MINUTES=15
PASSWORD_RESET_IP_LIMIT=5
# Only enable behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_X_FORWARDED_FOR=false

# Virus scanning of attachments: disabled | clamav (production default: clamav)
ATTACHMENT_VIRUS_SCAN=disabled
ATTACHMENT_SCAN_FAIL_CLOSED=true
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CLAMAV_TIMEOUT=30

# Live board polling interval in seconds
BOARD_POLL_INTERVAL_SECONDS=10
